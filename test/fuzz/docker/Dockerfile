FROM aflplusplus/aflplusplus:v5.03c

ARG USERNAME=ubuntu
ARG USER_UID=1000
ARG USER_GID=$USER_UID
ARG RUBY_VERSION=3.3.10
ENV MAKEFLAGS=-j8

RUN apt update && apt install -y sudo \
    && echo $USERNAME ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME


RUN wget https://cache.ruby-lang.org/pub/ruby/3.3/ruby-${RUBY_VERSION}.tar.gz -O ruby.tar.gz
RUN mkdir ruby-source && tar -xvf ruby.tar.gz -C ruby-source --strip-components=1
RUN apt update && apt -y install libyaml-dev libz-dev libssl-dev
RUN cd ruby-source && ./configure --disable-install-doc && make && make install
RUN gem install rake-compiler ruby_memcheck concurrent-ruby
RUN git clone https://github.com/pwndbg/pwndbg && cd pwndbg && ./setup.sh
ENV LC_CTYPE=C.UTF-8
RUN apt install -y libglib2.0-dev bsdmainutils
RUN git clone https://github.com/googleprojectzero/halfempty
# Guard g_close(task->fd, NULL) against task->fd == -1 so GLib >= 2.76 does not
# raise G_CRITICAL / SIGTRAP when halfempty cleans up already-closed task fds.
RUN cd halfempty && sed -i 's/g_close(task->fd, NULL);/if (task->fd != -1) g_close(task->fd, NULL);/' tree.c && make && cp halfempty /usr/bin/
RUN apt install -y valgrind uuid-dev default-jre python3 unzip
RUN wget https://www.antlr.org/download/antlr-4.8-complete.jar \
    && cp -f antlr-4.8-complete.jar /usr/local/lib
COPY test/fuzz/grammar/ruby.json /prism/test/fuzz/grammar/ruby.json
RUN git clone https://github.com/AFLplusplus/Grammar-Mutator
# Patch Grammar-Mutator before building libgrammarmutator-ruby.so:
# 1. Store serialized .tree files directly in /tmp/afl-tmpdir/grammar/trees
#    (on in-memory tmpfs) so we do not need to pre-create $AFL_DIR/grammar
#    before afl-fuzz starts (which otherwise triggers an AFL_AUTORESUME warning
#    about a missing fuzzer_stats file) and avoid writing thousands of .tree
#    files to the host bind-mount.
# 2. Disable runtime ANTLR4 reverse-parsing (load_tree_from_test_case). The
#    grammar worker starts from seeds and pre-built .tree files generated by
#    grammar_generator-ruby, and every grammar mutation/trim already has its
#    tree_t in memory (data->mutated_tree / data->trimmed_tree). Disabling
#    load_tree_from_test_case avoids multi-minute startup delays on arbitrary
#    corpus files and prevents exponential ANTLR4 ATN state blowup when syncing
#    byte-mutated inputs from other fuzzers.
RUN cd Grammar-Mutator && \
    sed -i 's|"%s/%s", tree_out_dir,|"/tmp/afl-tmpdir/grammar/trees/%s",|' src/grammar_mutator.c && \
    sed -i 's|memcpy(found, "/trees", 6);|snprintf(data->new_tree_fn, PATH_MAX - 1, "/tmp/afl-tmpdir/grammar/trees/%s", strrstr(fn, "/queue/") + 7);|' src/grammar_mutator.c && \
    sed -i 's/data->tree_cur = load_tree_from_test_case(fn);/data->tree_cur = NULL;/' src/grammar_mutator.c && \
    sed -i 's/tree = load_tree_from_test_case(fn);/tree = data->trimmed_tree ? tree_clone(data->trimmed_tree) : NULL;/' src/grammar_mutator.c && \
    make GRAMMAR_FILE=/prism/test/fuzz/grammar/ruby.json MAX_TREE_LEN=500 && \
    cp libgrammarmutator-ruby.so /usr/local/lib && \
    cp src/grammar_generator-ruby /usr/local/bin
RUN apt install -y tmux clang-format xxhash
ENV PATH="/usr/lib/llvm-${LLVM_VERSION}/bin:${PATH}"
COPY Gemfile Gemfile.lock prism.gemspec /prism/
WORKDIR /prism
RUN bundle install
USER $USERNAME


