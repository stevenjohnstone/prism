+bool isSanitizerTrapCall(const llvm::CallBase *CB) {
+
+  if (!CB) return false;
+  const Value *CalledOp = CB->getCalledOperand();
+  if (!CalledOp) return false;
+  const Function *Callee = dyn_cast<Function>(CalledOp->stripPointerCasts());
+  if (!Callee) return false;
+
+  if (Callee->getIntrinsicID() == Intrinsic::ubsantrap ||
+      (Callee->getIntrinsicID() == Intrinsic::trap &&
+       CB->hasMetadata(LLVMContext::MD_nosanitize)))
+    return true;
+
+  StringRef Name = Callee->getName();
+  if (Name == "__assert_fail" || Name == "__assert_perror_fail" ||
+      Name == "__assert_rtn" || Name == "__assert")
+    return true;
+
+#if LLVM_VERSION_MAJOR >= 18
+  return Name.starts_with("__asan_report_") ||
+         Name.starts_with("__ubsan_handle_") ||
+         Name.starts_with("__msan_warning") ||
+         Name.starts_with("__hwasan_tag_mismatch") ||
+         Name.starts_with("__cfi_check_fail") ||
+         Name.starts_with("llvm.ubsantrap");
+#else
+  return Name.startswith("__asan_report_") ||
+         Name.startswith("__ubsan_handle_") ||
+         Name.startswith("__msan_warning") ||
+         Name.startswith("__hwasan_tag_mismatch") ||
+         Name.startswith("__cfi_check_fail") ||
+         Name.startswith("llvm.ubsantrap");
+#endif
+
+}
+
+bool isSanitizerTrapBlock(const llvm::BasicBlock *BB) {
+
+  if (!BB) return false;
+
+  const BasicBlock *Cur = BB;
+  for (unsigned hop = 0; hop < 4; ++hop) {
+
+    const Instruction *Term = Cur->getTerminator();
+    if (!Term) return false;
+
+    if (const auto *BI = dyn_cast<BranchInst>(Term)) {
+
+      if (BI->isUnconditional()) {
+
+        bool has_trap_call = false;
+        bool clean = true;
+        for (const Instruction &I : *Cur) {
+
+          if (I.isTerminator() || I.isDebugOrPseudoInst()) continue;
+          if (const auto *II = dyn_cast<IntrinsicInst>(&I)) {
+
+            if (II->isLifetimeStartOrEnd()) continue;
+
+          }
+
+          if (const auto *CB = dyn_cast<CallBase>(&I)) {
+
+            if (isSanitizerTrapCall(CB)) {
+
+              has_trap_call = true;
+              continue;
+
+            }
+
+          }
+
+          if (I.getMetadata("afl.skip") ||
+              I.hasMetadata(LLVMContext::MD_nosanitize))
+            continue;
+
+          clean = false;
+          break;
+
+        }
+
+        if (clean && has_trap_call) return true;
+        if (clean) {
+
+          Cur = BI->getSuccessor(0);
+          continue;
+
+        }
+
+      }
+
+      return false;
+
+    }
+
+    if (!isa<UnreachableInst>(Term)) return false;
+
+    if (isa<UnreachableInst>(Cur->getFirstNonPHIOrDbgOrLifetime())) return true;
+    if (isFullyArtificialBlock(Cur)) return true;
+
+    bool saw_trap_call = false;
+    for (const Instruction &I : *Cur) {
+
+      if (I.isTerminator() || I.isDebugOrPseudoInst()) continue;
+      if (const auto *CB = dyn_cast<CallBase>(&I)) {
+
+        if (isSanitizerTrapCall(CB)) {
+
+          saw_trap_call = true;
+          continue;
+
+        }
+
+        if (const Function *Callee =
+                dyn_cast<Function>(CB->getCalledOperand()->stripPointerCasts())) {
+
+          if (Callee->isIntrinsic() ||
+              Callee->getName() == "__asan_handle_no_return")
+            continue;
+
+        }
+
+        return false;
+
+      }
+
+    }
+
+    return saw_trap_call;
+
+  }
+
+  return false;
+
+}
+
+static const BasicBlock *getSanitizerSlowPathTrap(const BasicBlock *Slow,
+                                                  const BasicBlock *X,
+                                                  const BasicBlock *Y) {
+
+  if (!Slow || Slow == X || Slow == Y) return nullptr;
+  if (Slow->getSinglePredecessor() != X) return nullptr;
+
+  const auto *BI = dyn_cast_or_null<BranchInst>(Slow->getTerminator());
+  if (!BI || !BI->isConditional()) return nullptr;
+
+  const BasicBlock *S0 = BI->getSuccessor(0);
+  const BasicBlock *S1 = BI->getSuccessor(1);
+  const BasicBlock *Trap = nullptr;
+  if (S0 == Y && isSanitizerTrapBlock(S1))
+    Trap = S1;
+  else if (S1 == Y && isSanitizerTrapBlock(S0))
+    Trap = S0;
+  else
+    return nullptr;
+
+  for (const Instruction &I : *Slow) {
+
+    if (I.isTerminator() || I.isDebugOrPseudoInst()) continue;
+    if (I.mayHaveSideEffects()) return nullptr;
+
+  }
+
+  return Trap;
+
+}
+
+bool isSanitizerOnlyValue(const llvm::Instruction &Root) {
+
+  const Function *F = Root.getFunction();
+  if (!F) return false;
+  bool is_msan = F->hasFnAttribute(Attribute::SanitizeMemory);
+
+  SmallVector<const Value *, 16> Worklist;
+  SmallPtrSet<const Value *, 32> Visited;
+  Worklist.push_back(&Root);
+  bool saw_sanitizer_sink = false;
+
+  while (!Worklist.empty()) {
+
+    const Value *V = Worklist.pop_back_val();
+    if (!Visited.insert(V).second) continue;
+    if (Visited.size() > 128) return false;
+
+    for (const User *U : V->users()) {
+
+      if (const auto *BI = dyn_cast<BranchInst>(U)) {
+
+        if (!BI->isConditional() || BI->getCondition() != V) return false;
+        const BasicBlock *B0 = BI->getSuccessor(0);
+        const BasicBlock *B1 = BI->getSuccessor(1);
+        const BasicBlock *Parent = BI->getParent();
+        if (BI->hasMetadata(LLVMContext::MD_nosanitize) ||
+            isSanitizerTrapBlock(B0) || isSanitizerTrapBlock(B1) ||
+            getSanitizerSlowPathTrap(B0, Parent, B1) ||
+            getSanitizerSlowPathTrap(B1, Parent, B0)) {
+
+          saw_sanitizer_sink = true;
+          continue;
+
+        }
+
+        return false;
+
+      } else if (const auto *CB = dyn_cast<CallBase>(U)) {
+
+        if (CB->hasMetadata(LLVMContext::MD_nosanitize) ||
+            isSanitizerTrapCall(CB)) {
+
+          saw_sanitizer_sink = true;
+          continue;
+
+        }
+
+        const Value *CalledOp = CB->getCalledOperand();
+        const Function *Callee =
+            CalledOp ? dyn_cast<Function>(CalledOp->stripPointerCasts())
+                     : nullptr;
+        if (!Callee) return false;
+        StringRef Name = Callee->getName();
+#if LLVM_VERSION_MAJOR >= 18
+        if (Name.starts_with("__msan_") || Name.starts_with("__asan_") ||
+            Name.starts_with("__ubsan_") || Name.starts_with("__sanitizer_")) {
+#else
+        if (Name.startswith("__msan_") || Name.startswith("__asan_") ||
+            Name.startswith("__ubsan_") || Name.startswith("__sanitizer_")) {
+#endif
+          saw_sanitizer_sink = true;
+          continue;
+
+        }
+
+        if (Callee->isIntrinsic()) {
+
+          Worklist.push_back(CB);
+          continue;
+
+        }
+
+        return false;
+
+      } else if (const auto *SI = dyn_cast<StoreInst>(U)) {
+
+        if (SI->getValueOperand() != V) return false;
+        if (SI->hasMetadata(LLVMContext::MD_nosanitize)) {
+
+          saw_sanitizer_sink = true;
+          continue;
+
+        }
+
+        const Value *Ptr = SI->getPointerOperand()->stripPointerCasts();
+        if (const auto *GV = dyn_cast<GlobalValue>(Ptr)) {
+
+          StringRef Name = GV->getName();
+#if LLVM_VERSION_MAJOR >= 18
+          if (Name.starts_with("__msan_") || Name.starts_with("__asan_") ||
+              Name.starts_with("__ubsan_")) {
+#else
+          if (Name.startswith("__msan_") || Name.startswith("__asan_") ||
+              Name.startswith("__ubsan_")) {
+#endif
+            saw_sanitizer_sink = true;
+            continue;
+
+          }
+
+        }
+
+        if (is_msan &&
+            (isa<IntToPtrInst>(Ptr) ||
+             (isa<ConstantExpr>(Ptr) &&
+              cast<ConstantExpr>(Ptr)->getOpcode() == Instruction::IntToPtr))) {
+
+          saw_sanitizer_sink = true;
+          continue;
+
+        }
+
+        return false;
+
+      } else if (isa<ReturnInst>(U) || isa<SwitchInst>(U) ||
+                 isa<LoadInst>(U) || isa<AtomicRMWInst>(U) ||
+                 isa<AtomicCmpXchgInst>(U)) {
+
+        return false;
+
+      } else if (isa<Instruction>(U) || isa<Operator>(U)) {
+
+        Worklist.push_back(U);
+
+      } else {
+
+        return false;
+
+      }
+
+    }
+
+  }
+
+  return saw_sanitizer_sink;
+
+}
+
+static bool isAsanStackMallocCall(const Value *V) {
+
+  const auto *CB = dyn_cast_or_null<CallBase>(V);
+  if (!CB) return false;
+  const Value *CalledOp = CB->getCalledOperand();
+  const Function *Callee =
+      CalledOp ? dyn_cast<Function>(CalledOp->stripPointerCasts()) : nullptr;
+  if (!Callee) return false;
+#if LLVM_VERSION_MAJOR >= 18
+  return Callee->getName().starts_with("__asan_stack_malloc_");
+#else
+  return Callee->getName().startswith("__asan_stack_malloc_");
+#endif
+
+}
+
+static bool isAsanStackMallocValue(const Value *V) {
+
+  if (!V) return false;
+  if (isAsanStackMallocCall(V)) return true;
+
+  if (const auto *PN = dyn_cast<PHINode>(V)) {
+
+    for (const Value *Inc : PN->incoming_values()) {
+
+      if (isAsanStackMallocCall(Inc)) return true;
+
+    }
+
+  }
+
+  return false;
+
+}
+
+static bool isAsanUarOptionLoad(const Value *V) {
+
+  const auto *LI = dyn_cast_or_null<LoadInst>(V);
+  if (!LI) return false;
+  const Value *Ptr = LI->getPointerOperand()->stripPointerCasts();
+  const auto  *GV = dyn_cast<GlobalValue>(Ptr);
+  return GV && GV->getName() == "__asan_option_detect_stack_use_after_return";
+
+}
+
+SanitizerPreSplitInfo analyzeSanitizerPreSplit(Function &F) {
+
+  SanitizerPreSplitInfo Pre;
+
+  for (BasicBlock &BB : F) {
+
+    BasicBlock *X = &BB;
+    if (isSanitizerTrapBlock(X)) {
+
+      Pre.InternalBlocks.push_back(X);
+      continue;
+
+    }
+
+    if (X->getTerminator() && isa<SwitchInst>(X->getTerminator())) {
+
+      BasicBlock *TrapSucc = nullptr;
+      BasicBlock *NonTrapSucc = nullptr;
+      bool        multiple_non_trap = false;
+
+      for (BasicBlock *Succ : successors(X)) {
+
+        if (isSanitizerTrapBlock(Succ)) {
+
+          if (!TrapSucc) TrapSucc = Succ;
+          Pre.InternalBlocks.push_back(Succ);
+
+        } else if (Succ != X) {
+
+          if (!NonTrapSucc)
+            NonTrapSucc = Succ;
+          else if (NonTrapSucc != Succ)
+            multiple_non_trap = true;
+
+        } else {
+
+          multiple_non_trap = true;
+
+        }
+
+      }
+
+      if (TrapSucc && NonTrapSucc && !multiple_non_trap) {
+
+        BasicBlock *Y = NonTrapSucc;
+        bool        only_x_and_trap = true;
+        for (BasicBlock *Pred : predecessors(Y)) {
+
+          if (Pred != X && !isSanitizerTrapBlock(Pred)) {
+
+            only_x_and_trap = false;
+            break;
+
+          }
+
+        }
+
+        if (only_x_and_trap && !Pre.ChainNext.count(X) &&
+            !Pre.ChainPrev.count(Y)) {
+
+          Pre.ChainNext[X] = Y;
+          Pre.ChainPrev[Y] = X;
+
+        } else if (!only_x_and_trap) {
+
+          Pre.UncondTarget[X] = Y;
+
+        }
+
+        Pre.Diamonds.push_back(std::make_tuple(X, TrapSucc, Y));
+
+      }
+
+      continue;
+
+    }
+
+    auto *BI = dyn_cast_or_null<BranchInst>(X->getTerminator());
+    if (!BI || !BI->isConditional()) continue;
+
+    if (const auto *Cmp = dyn_cast<ICmpInst>(BI->getCondition())) {
+
+      if (isAsanUarOptionLoad(Cmp->getOperand(0)) ||
+          isAsanUarOptionLoad(Cmp->getOperand(1))) {
+
+        for (unsigned idx = 0; idx < 2; ++idx) {
+
+          BasicBlock *MallocBB = BI->getSuccessor(idx);
+          BasicBlock *ThreadBB = BI->getSuccessor(1 - idx);
+          auto       *MallocBI =
+              dyn_cast_or_null<BranchInst>(MallocBB->getTerminator());
+          auto *ThreadBI =
+              dyn_cast_or_null<BranchInst>(ThreadBB->getTerminator());
+          if (!MallocBI || !MallocBI->isConditional() || !ThreadBI ||
+              !ThreadBI->isUnconditional())
+            continue;
+          BasicBlock *ContBB = ThreadBI->getSuccessor(0);
+          if ((MallocBI->getSuccessor(0) == ThreadBB &&
+               MallocBI->getSuccessor(1) == ContBB) ||
+              (MallocBI->getSuccessor(1) == ThreadBB &&
+               MallocBI->getSuccessor(0) == ContBB)) {
+
+            Pre.InternalBlocks.push_back(MallocBB);
+            Pre.InternalBlocks.push_back(ThreadBB);
+            if (!Pre.ChainNext.count(X) && !Pre.ChainPrev.count(ContBB)) {
+
+              Pre.ChainNext[X] = ContBB;
+              Pre.ChainPrev[ContBB] = X;
+
+            }
+
+            Pre.Diamonds.push_back(std::make_tuple(X, MallocBB, ThreadBB));
+            Pre.Diamonds.push_back(std::make_tuple(MallocBB, ThreadBB, ContBB));
+            break;
+
+          }
+
+        }
+
+        continue;
+
+      }
+
+      if (isAsanStackMallocValue(Cmp->getOperand(0)) ||
+          isAsanStackMallocValue(Cmp->getOperand(1))) {
+
+        BasicBlock *B0 = BI->getSuccessor(0);
+        BasicBlock *B1 = BI->getSuccessor(1);
+        auto       *B0BI = dyn_cast_or_null<BranchInst>(B0->getTerminator());
+        auto       *B1BI = dyn_cast_or_null<BranchInst>(B1->getTerminator());
+        if (B0->getSinglePredecessor() == X &&
+            B1->getSinglePredecessor() == X && B0BI &&
+            B0BI->isUnconditional() && B1BI && B1BI->isUnconditional() &&
+            B0BI->getSuccessor(0) == B1BI->getSuccessor(0)) {
+
+          BasicBlock *ExitBB = B0BI->getSuccessor(0);
+          Pre.InternalBlocks.push_back(B0);
+          Pre.InternalBlocks.push_back(B1);
+          bool only_b0_b1 = true;
+          for (BasicBlock *Pred : predecessors(ExitBB)) {
+
+            if (Pred != B0 && Pred != B1) {
+
+              only_b0_b1 = false;
+              break;
+
+            }
+
+          }
+
+          if (only_b0_b1 && !Pre.ChainNext.count(X) &&
+              !Pre.ChainPrev.count(ExitBB)) {
+
+            Pre.ChainNext[X] = ExitBB;
+            Pre.ChainPrev[ExitBB] = X;
+
+          } else if (!only_b0_b1) {
+
+            Pre.UncondTarget[X] = ExitBB;
+
+          }
+
+          Pre.Diamonds.push_back(std::make_tuple(B0, B1, ExitBB));
+          continue;
+
+        }
+
+      }
+
+    }
+
+    for (unsigned idx = 0; idx < 2; ++idx) {
+
+      BasicBlock *CheckBB = BI->getSuccessor(idx);
+      BasicBlock *Y = BI->getSuccessor(1 - idx);
+      if (Y == X || isSanitizerTrapBlock(Y)) continue;
+
+      if (isSanitizerTrapBlock(CheckBB)) {
+
+        Pre.InternalBlocks.push_back(CheckBB);
+        bool only_x_and_check = true;
+        for (BasicBlock *Pred : predecessors(Y)) {
+
+          if (Pred != X && Pred != CheckBB) {
+
+            only_x_and_check = false;
+            break;
+
+          }
+
+        }
+
+        if (only_x_and_check && !Pre.ChainNext.count(X) &&
+            !Pre.ChainPrev.count(Y)) {
+
+          Pre.ChainNext[X] = Y;
+          Pre.ChainPrev[Y] = X;
+
+        } else if (!only_x_and_check) {
+
+          Pre.UncondTarget[X] = Y;
+
+        }
+
+        Pre.Diamonds.push_back(std::make_tuple(X, CheckBB, Y));
+        break;
+
+      }
+
+      if (const BasicBlock *Trap = getSanitizerSlowPathTrap(CheckBB, X, Y)) {
+
+        Pre.InternalBlocks.push_back(CheckBB);
+        Pre.InternalBlocks.push_back(const_cast<BasicBlock *>(Trap));
+        bool only_x_and_slow = true;
+        for (BasicBlock *Pred : predecessors(Y)) {
+
+          if (Pred != X && Pred != CheckBB) {
+
+            only_x_and_slow = false;
+            break;
+
+          }
+
+        }
+
+        if (only_x_and_slow && !Pre.ChainNext.count(X) &&
+            !Pre.ChainPrev.count(Y)) {
+
+          Pre.ChainNext[X] = Y;
+          Pre.ChainPrev[Y] = X;
+
+        } else if (!only_x_and_slow) {
+
+          Pre.UncondTarget[X] = Y;
+
+        }
+
+        Pre.Diamonds.push_back(std::make_tuple(X, CheckBB, Y));
+        break;
+
+      }
+
+    }
+
+  }
+
+  return Pre;
+
+}
+
+SanitizerCFGInfo finalizeSanitizerCFG(Function                    &F,
+                                      const SanitizerPreSplitInfo &Pre) {
+
+  SanitizerCFGInfo Info;
+
+  for (BasicBlock *B : Pre.InternalBlocks)
+    Info.SkipBlocks.insert(B);
+
+  for (BasicBlock &BB : F) {
+
+    if (isSanitizerTrapBlock(&BB)) Info.SkipBlocks.insert(&BB);
+
+  }
+
+  for (const auto &D : Pre.Diamonds) {
+
+    BasicBlock *FastPred = std::get<0>(D);
+    BasicBlock *SlowPred = std::get<1>(D);
+    BasicBlock *ContBB = std::get<2>(D);
+    for (BasicBlock *P : predecessors(ContBB)) {
+
+      if (P == FastPred || P == SlowPred) continue;
+      BasicBlock *SP = P->getSinglePredecessor();
+      if (SP == FastPred || (SlowPred && SP == SlowPred)) {
+
+        if (&*P->getFirstNonPHIOrDbg() == P->getTerminator())
+          Info.SkipBlocks.insert(P);
+
+      }
+
+    }
+
+  }
+
+  for (const auto &KV : Pre.ChainNext) {
+
+    BasicBlock *X = KV.first;
+    BasicBlock *Y = KV.second;
+    Info.SkipBlocks.insert(Y);
+
+    if (!Pre.ChainPrev.count(X)) {
+
+      SmallPtrSet<const BasicBlock *, 16> Seen;
+      BasicBlock                         *Cur = X;
+      while (Pre.ChainNext.count(Cur) && Seen.insert(Cur).second) {
+
+        Info.ChainHead[Cur] = X;
+        Cur = Pre.ChainNext.lookup(Cur);
+
+      }
+
+      Info.ChainHead[Cur] = X;
+      Info.ChainTail[X] = Cur;
+
+    }
+
+  }
+
+  for (const auto &KV : Pre.UncondTarget)
+    Info.UncondTarget[KV.first] = KV.second;
+
+  for (const BasicBlock *BB : Info.SkipBlocks)
+    markAflSyntheticBlock(const_cast<BasicBlock *>(BB));
+
+  return Info;
+
+}
