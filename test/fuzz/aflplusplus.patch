+bool isSanitizerTrapCall(const llvm::CallBase *CB);
+bool isSanitizerTrapBlock(const llvm::BasicBlock *BB);
+bool isSanitizerOnlyValue(const llvm::Instruction &Root);
+
+/* Pre-pass before SplitAllCriticalEdges: records sanitizer check chains and
+   diamond checks so that critical-edge blocks created for them can be skipped
+   after SplitAllCriticalEdges runs. */
+struct SanitizerPreSplitInfo {
+
+  llvm::DenseMap<llvm::BasicBlock *, llvm::BasicBlock *> ChainPrev;
+  llvm::DenseMap<llvm::BasicBlock *, llvm::BasicBlock *> ChainNext;
+  llvm::DenseMap<llvm::BasicBlock *, llvm::BasicBlock *> UncondTarget;
+  llvm::SmallVector<llvm::BasicBlock *, 16>              InternalBlocks;
+  llvm::SmallVector<
+      std::tuple<llvm::BasicBlock *, llvm::BasicBlock *, llvm::BasicBlock *>, 8>
+      Diamonds;
+
+};
+
+struct SanitizerCFGInfo {
+
+  llvm::DenseMap<const llvm::BasicBlock *, const llvm::BasicBlock *> ChainHead;
+  llvm::DenseMap<const llvm::BasicBlock *, const llvm::BasicBlock *> ChainTail;
+  llvm::DenseMap<const llvm::BasicBlock *, const llvm::BasicBlock *>
+                                                  UncondTarget;
+  llvm::SmallPtrSet<const llvm::BasicBlock *, 32> SkipBlocks;
+
+  const llvm::BasicBlock *getHead(const llvm::BasicBlock *BB) const {
+
+    auto it = ChainHead.find(BB);
+    return it != ChainHead.end() ? it->second : BB;
+
+  }
+
+  const llvm::BasicBlock *getTail(const llvm::BasicBlock *BB) const {
+
+    auto it = ChainTail.find(BB);
+    return it != ChainTail.end() ? it->second : BB;
+
+  }
+
+  const llvm::BasicBlock *getUncondTarget(const llvm::BasicBlock *BB) const {
+
+    auto it = UncondTarget.find(BB);
+    return it != UncondTarget.end() ? it->second : nullptr;
+
+  }
+
+  bool isSkippedBlock(const llvm::BasicBlock *BB) const {
+
+    return SkipBlocks.contains(BB);
+
+  }
+
+};
